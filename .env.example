# Web is on Vercel. API extras stay on Railway only if you still run that box.
# Never set PRIVATE_KEY on either dashboard.

# --- Vercel (web) ---
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_HOST=quiver.diy
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RH_EXPLORER=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_PONS_APP=https://pons.family
NEXT_PUBLIC_FACTORY_ADDRESS=0x39674D79FDe557f8483905094AF65f0ae43d2e99
NEXT_PUBLIC_SUBSCRIPTION_ADDRESS=0x8C6bcBf36747DAebBf732752c0EbCB37F53a77ca
NEXT_PUBLIC_REGISTRY_ADDRESS=0x50Bcac45Bf8A29020016075E9981841BEd9B8F50
NEXT_PUBLIC_BUYBACK_ADDRESS=0x09E7198143C14d544cF9e75911Fa0212DdE464DB
NEXT_PUBLIC_TREASURY_ADDRESS=0xD9bafeA718417eE1153e31B8dB2B5D8Ee85F80A9

# Do not set API_UPSTREAM on Vercel. /api is handled by Next.js now.
# Do not put an Alchemy URL in NEXT_PUBLIC_RH_RPC_URL.

# --- Railway (only if the API service still exists) ---
DATABASE_URL=file:../data/quiver.db
API_PORT=4001
WEB_ORIGIN=https://quiver.diy
