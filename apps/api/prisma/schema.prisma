generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Site {
  id            String   @id @default(cuid())
  slug          String   @unique
  token         String
  curve         String
  creator       String
  name          String
  symbol        String
  logo          String   @default("")
  description   String   @default("")
  twitter       String   @default("")
  telegram      String   @default("")
  website       String   @default("")
  theme         String   @default("forest")
  hostname      String   @default("")
  hostnameVerified Boolean @default(false)
  createdAt     DateTime @default(now())
  trades        Trade[]
}

model Trade {
  id        String   @id @default(cuid())
  site      Site     @relation(fields: [siteId], references: [id])
  siteId    String
  side      String
  actor     String
  quote     String
  tokens    String
  txHash    String   @unique
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

model SubscriptionEvent {
  id        String   @id @default(cuid())
  account   String
  planId    String
  paid      String
  expiresAt String
  txHash    String   @unique
  createdAt DateTime @default(now())
}

model BuybackFill {
  id        String   @id @default(cuid())
  payer     String
  ethIn     String
  tokensOut String
  venue     String
  txHash    String   @unique
  createdAt DateTime @default(now())
}
